# SANTOSO-GRID Environment Configuration
# Copy this to .env and edit values

# Server Configuration
SERVER_IP=your_server_ip
SERVER_PORT=5000

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=25

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_user_id_here
TELEGRAM_NOTIFICATIONS=enabled

# Sending Configuration
MAX_EMAILS_PER_HOUR=5000
PROXY_ROTATION_EVERY=500
RANDOM_DELAY_MIN=0.5
RANDOM_DELAY_MAX=3.0

# Anti-Detection
ENABLE_HEADER_RANDOMIZATION=true
ENABLE_CONTENT_OBFUSCATION=true
AUTO_BOUNCE_CLEANING=true

# Database
DATABASE_PATH=./data/santosogrid.db